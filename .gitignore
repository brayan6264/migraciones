# Entornos virtuales
.venv/
venv/
env/
ENV/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/

# Variables de entorno y credenciales
.env
.env.*
!.env.example
*service-account*.json
*credentials*.json
credentials/
secrets/
*.pem
*.key

# Base de datos local de desarrollo.
# Los archivos auxiliares de SQLite (-wal / -shm / -journal) DEBEN ignorarse
# igual que el .db: `*.db` no los cubre porque su nombre no termina en ".db".
# Si se versionan, un `git pull` mezcla el WAL de una máquina con el .db de
# otra y SQLite falla con "database disk image is malformed".
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

# Archivos temporales de la aplicación
data/
!data/.gitkeep

# Tests y herramientas de calidad
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Editores / IDEs
.vscode/
.idea/
*.swp
*.swo

# Claude / asistentes
.claude/

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
